  "scripts": {
    "build": "tsup",
    "generate": "bun scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.6"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.6"
  }
}
